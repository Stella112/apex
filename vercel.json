{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "packages/web/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{packages/*/dist/**,config/dist/**}"
    }
  }
}
